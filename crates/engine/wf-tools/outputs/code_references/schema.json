{
  "description": "Find all references of the symbol at a file path plus 1-based line number. Returns grouped locations with snippets and caller names.",
  "enabled": true,
  "id": "code_references",
  "metadata": {
    "category": "code_context",
    "risk_level": "read_only",
    "tags": [
      "code",
      "references"
    ]
  },
  "name": "code_references",
  "parameters": {
    "additionalProperties": false,
    "properties": {
      "column": {
        "description": "1-based column number (optional)",
        "type": "integer"
      },
      "line": {
        "description": "1-based line number of the symbol",
        "type": "integer"
      },
      "path": {
        "description": "File path containing the symbol",
        "type": "string"
      },
      "project_id": {
        "description": "Project id to search within (falls back to the configured default)",
        "type": "integer"
      },
      "symbol": {
        "description": "Symbol name (optional, for documentation)",
        "type": "string"
      }
    },
    "required": [
      "path",
      "line"
    ],
    "type": "object"
  },
  "tool_type": "stateless"
}
