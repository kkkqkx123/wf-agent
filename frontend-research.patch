+							}"
+						>
+							#{{ execution.retryOf }}
+						</RouterLink>
+					</N8nText>
+				</div>
+				<WorkflowExecutionAnnotationTags
+					v-if="isAnnotationEnabled && execution"
+					:execution="execution"
+				/>
+			</div>
+
+			<div :class="$style.actions">
