+            Motion::LineEnd => TextPos::new(pos.line, line_end(pos.line)),
+            Motion::PageUp(rows) => self.move_rows(pos, usize::from(rows), true),
+            Motion::PageDown(rows) => self.move_rows(pos, usize::from(rows), false),
+        }
+    }
