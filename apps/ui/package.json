{
	"name": "@wf-agent/ui",
	"version": "0.1.0",
	"description": "Shared Svelte UI primitives, icons and design tokens",
	"type": "module",
	"license": "MIT",
	"private": true,
	"scripts": {
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"svelte": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"svelte": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./components/*": {
			"svelte": "./src/components/*",
			"default": "./src/components/*"
		},
		"./components/variants": "./src/components/variants.ts",
		"./components/table": "./src/components/table.ts",
		"./icons/*": {
			"svelte": "./src/icons/*",
			"default": "./src/icons/*"
		},
		"./icons/paths": "./src/icons/paths.ts",
		"./cn": "./src/cn.ts",
		"./status": "./src/status.ts",
		"./format": "./src/format.ts",
		"./virtualization": "./src/virtualization.ts",
		"./link": "./src/link.ts",
		"./styles/*": "./src/styles/*"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.56.4",
		"svelte-check": "^4.7.2",
		"typescript": "^5.9.3"
	},
	"files": [
		"src"
	]
}
