# Environment file template for wf-server (managed deployment).
#
# Copy to the managed directory as wf-server.env (rendered by
# deploy/scripts/render-config.sh with mode 0600) and fill in real values
# on the target machine. This file never enters version control.
#
# Secrets live ONLY here (or in the process environment). Config files
# reference them through ${VAR} / ${VAR:default} placeholders, which the
# process expands from its own environment at startup.
#
# Frozen legacy names stay as-is so deployed environments keep working;
# new variables must use the WF_<DOMAIN>_<KEY> form.

# Server listen address. Wins over the server.toml file layer.
WF_SERVER_BIND_ADDR=

# API key gate. Secrets NEVER live in auth.toml; they come from here.
AUTH_ENABLED=
API_KEYS=

# Rate-limit middleware tuning (frozen names, see rate-limit.toml).
RATE_LIMIT_ENABLED=
RATE_LIMIT_WINDOW_MS=
RATE_LIMIT_MAX_REQUESTS=

# Storage credentials for the postgres backend (see storage.toml).
DB_PASSWORD=

# LLM provider keys, read when a profile has no stored credential.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
