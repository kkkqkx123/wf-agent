{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true,
		"paths": {
			"#lib/*": ["./src/lib/*"],
			"#paraglide/*": ["./src/lib/paraglide/*"]
		}
	},
	"include": [
		"src",
		"test",
		"*",
		".svelte-kit/ambient.d.ts",
		".svelte-kit/non-ambient.d.ts",
		".svelte-kit/env.d.ts"
	],
	"exclude": [
		"src/service-worker"
	]
}
