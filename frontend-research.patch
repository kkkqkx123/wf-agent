+					:disabled="!pinBlockedByRedaction"
+				>
+					<RouterLink
+						:to="{
+							name: VIEWS.EXECUTION_DEBUG,
+							params: {
+								workflowId: execution.workflowId,
+								executionId: execution.id,
+							},
+						}"
+					>
+						<N8nButton
+							size="medium"
+							variant="outline"
+							:class="$style.debugLink"
+							:disabled="!workflowPermissions.update || pinBlockedByRedaction"
