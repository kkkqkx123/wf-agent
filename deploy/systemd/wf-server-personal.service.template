# User service for wf-server (personal use).
#
# Single unit serves every business directory: the request carries the
# directory (`x-wf-directory` header or `directory` query parameter).
# There is no server-side default workspace: a directory-less request to
a workspace-bound route fails instead of binding anywhere silently.
# Enable lingering (loginctl enable-linger) to keep it running
# after logout.
#
# Principal: single user. Reads the XDG settings directory plus the
# business project trees listed in WF_DIRECTORY_ROOTS only.
#
# WorkingDirectory is intentionally neutral: relative storage paths would
# resolve against it, so personal deployments must pin absolute paths
# through WF_STORAGE_SQLITE_DB_PATH (see wf-server.env.template).
# `--config` selects the project-layer config source only; it is never
# an operation default.

[Unit]
Description=wf-agent server (personal)
After=network.target

[Service]
Type=simple
WorkingDirectory=/
EnvironmentFile=-@@SETTINGS_DIR@@/wf-server.env
ExecStart=/usr/local/bin/wf-server --config @@PROJECT_ROOT@@ --settings-dir @@SETTINGS_DIR@@
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
