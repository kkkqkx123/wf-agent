# Logging Configuration Example

# Global default log level
# Available values: debug, info, warn, error, off
LOG_LEVEL=info

# Log level for SDK packages
# If set, overrides the global log level
LOG_LEVEL_SDK=debug

# Log level for Tool Executors packages
LOG_LEVEL_TOOL_EXECUTORS=info

# Log level for Common Utils packages
LOG_LEVEL_COMMON_UTILS=warn

# Examples for other packages
# LOG_LEVEL_APPS=info
# LOG_LEVEL_TYPES=warn
