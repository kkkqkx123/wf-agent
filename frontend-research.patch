+		uiStore.addFirstStepOnLoad = false;
+		uiStore.addFirstStepOnLoadSource = undefined;
+	}
+}
+
+/**
+ * Routing
+ */
+
+function updateNodeRoute(nodeId: string) {
+	const nodeUi = workflowDocumentStore?.value?.findNodeByPartialId(nodeId);
