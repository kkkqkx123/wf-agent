// Wasm plugin world for the component-model host (`wasm/component.rs`).
//
// Status: implemented. Component binaries (detected by magic header in the
// loader) run through `wasmtime::component::bindgen!` bindings against this
// world with a WASI p2 context. The core-module `wf_*` export contract
// (`wf-plugin-sdk/src/wasm.rs`) remains supported: guests may target either
// contract, and both paths expose the same `Plugin` trait surface upstairs.
//
// Versioning: still `@0.1.0-draft`. Guest and host must agree on the
// interface names below; incompatible world changes require a version bump.

package wf:plugin@0.1.0-draft;

interface lifecycle {
    /// Hook input envelope, mirroring the JSON passed today.
    record hook-input {
        plugin-id: string,
        config: string,
    }

    on-load: func(input: hook-input) -> result<_, string>;
    on-activate: func(input: hook-input) -> result<_, string>;
    on-deactivate: func() -> result<_, string>;
    on-unload: func() -> result<_, string>;
    on-config-change: func(config: string) -> result<_, string>;
}

interface contributions {
    record middleware-decl {
        phase: string,
        priority: s32,
    }

    /// Contribution declaration, mirroring `wf_register` JSON today.
    record declaration {
        node-types: list<string>,
        tool-types: list<string>,
        llm-providers: list<string>,
        event-handlers: list<string>,
        middleware: list<middleware-decl>,
    }

    register: func() -> declaration;

    /// Single dispatch entry, mirroring `wf_dispatch` today. Payloads stay
    /// JSON strings by design (cross-language guests, small control docs);
    /// structured payloads would be a breaking contract upgrade.
    dispatch: func(
        handler-type: string,
        handler-name: string,
        input-json: string,
    ) -> result<string, string>;

    /// Middleware answers with either a JSON boolean (legacy: continue or
    /// stop, context unchanged) or an envelope object
    /// `{"proceed": bool, "context": <replacement>}` (both keys optional,
    /// defaulting to `true` and the incoming context). The host threads
    /// the returned context through the rest of the chain.
}

interface host-log {
    /// Structured guest-to-host log. Levels: 0 trace, 1 debug, 2 info,
    /// 3 warn, 4 and above error. Best-effort: over-long messages are
    /// truncated and the call never fails the guest.
    log: func(level: u32, message: string);
}

world plugin {
    import host-log;
    export lifecycle;
    export contributions;
}
