+    trigger_name?: string;
+    workflow_name?: string;
+    execution_id?: string;
+    status?: string;
+    fired_at?: string;
+    payload?: string;
+}
+
+function toTriggerRecord(d: TriggerRecordDto): TriggerRecord {
+    return {
+        id: d.id ?? '',
+        triggerName: d.trigger_name ?? '',
+        workflowName: d.workflow_name ?? '',
+        executionId: d.execution_id ?? '',
