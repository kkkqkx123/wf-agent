+        <Suspense fallback={null}>
+          <WorkflowLocalStorageBridge />
+        </Suspense>
+        <DatasetsDetailProvider nodes={nodes}>{children}</DatasetsDetailProvider>
+      </WorkflowHistoryStoreInitializer>
+    </ReactFlowProvider>
+  )
+}
+
+export default memo(WorkflowWithDefaultContext)
