# Environment file template for wf-server (managed and personal use).
#
# Rendered once by deploy/scripts/render-config.sh (mode 0600) and filled
# in on the target machine. This file never enters version control.
# Every value below is decided at use time: editing this file and
# restarting the service rebinds the deployment without re-rendering
# the unit or reloading systemd.
#
# Secrets live ONLY here (or in the process environment). Config files
# reference them through ${VAR} / ${VAR:default} placeholders, which the
# process expands from its own environment at startup.
#
# There is no default workspace. Every workspace-bound request names its
# directory explicitly; a directory-less request fails instead of binding
# anywhere silently.
#
# Frozen legacy names stay as-is so deployed environments keep working;
# new variables must use the WF_<DOMAIN>_<KEY> form.

# Workspace domain kill-switch. Defaults to enabled; set to false to lock
# every workspace-bound route down to an explicit rejection.
WF_USER_GIT_ENABLED=

# Absolute sqlite database path. Unset keeps the storage.toml file value;
# set it in service deployments so the database never depends on the
# process working directory (single global database for every directory).
WF_STORAGE_SQLITE_DB_PATH=

# Absolute output/log directory. Unset keeps the output.toml file value;
# set it in service deployments so file logs land under /var/log/wf.
WF_OUTPUT_DIR=

# Servable directory roots (comma-separated absolute paths). Explicit
# request directories must fall inside one of these; empty permits every
# validated directory the client names.
WF_DIRECTORY_ROOTS=

# Server listen address. Wins over the server.toml file layer.
WF_SERVER_BIND_ADDR=

# API key gate. Secrets NEVER live in auth.toml; they come from here.
AUTH_ENABLED=
API_KEYS=

# Rate-limit middleware tuning (frozen names, see rate-limit.toml).
RATE_LIMIT_ENABLED=
RATE_LIMIT_WINDOW_MS=
RATE_LIMIT_MAX_REQUESTS=

# Storage credentials for the postgres backend (see storage.toml).
DB_PASSWORD=

# LLM provider keys, read when a profile has no stored credential.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
