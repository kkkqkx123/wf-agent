+        function dispatch(
+                method: string,
+                path: string,
+                query: Record<string, unknown>,
+                body: unknown,
+        ): unknown {
+                for (const [pattern, handler] of routes[method] ?? []) {
+                        const params = matchPath(pattern, path);
+                        if (params !== null) {
+                                return handler(params, query, body);
+                        }
+                }
+                return undefined;
+        }
+
+        return { on, dispatch };
