/**
 * Execution Service
 * Unified execution layer for workflow executions.
 * 
 * Design Principle: All workflow executions go through SDK.
 * Terminals are used ONLY for display/output purposes, not for execution.
 *
 * Subprocess modes (foreground/background):
 *   Workflows are executed in a child process spawned via child_process.fork().
 *   The child process communicates back to the parent via IPC messages.
 *   This allows the CLI process to exit independently of the workflow execution.
 */

import { fork } from "child_process";
import { resolve, dirname } from "path";
import { fileURLToPath } from "url";
import { getOutput } from "../../utils/output.js";
import type { SDKInstance } from "@wf-agent/sdk/api";
import { WorkflowExecutionAdapter } from "../../adapters/workflow-execution-adapter.js";
import { TerminalManager } from "../terminal/terminal-manager.js";
import type { TerminalSession } from "../terminal/types.js";
import type { WorkflowExecutionResult, BaseEvent, NodeCompletedEvent, WorkflowExecutionCompletedEvent, WorkflowExecutionFailedEvent, WorkflowExecutionMode } from "@wf-agent/types";
import { createExecutionScopedSubscription } from "@wf-agent/sdk/api";
import { CLIError, ErrorCode } from "../../types/cli-types.js";
import { getMode } from "../../utils/mode-detector.js";

const output = getOutput();

/**
 * Execution result interface
 * Uses shared WorkflowExecutionMode from @wf-agent/types.
 */
export interface ExecutionResult {
  mode: WorkflowExecutionMode;
  executionId: string;
  workflowId: string;
  status: string;
  startTime: Date;
  pid?: number;
  logFile?: string;
  detached: boolean;
  result?: WorkflowExecutionResult;
  completion?: Promise<void>;
}

/**
 * Execution Service
 * Provides unified interface for workflow execution across different modes.
 */
export class ExecutionService {
  private terminalManager: TerminalManager;
  private adapter: WorkflowExecutionAdapter;
  private sdk: SDKInstance;

  constructor(sdk: SDKInstance, terminalManager: TerminalManager) {
    this.sdk = sdk;
    this.terminalManager = terminalManager;
    this.adapter = new WorkflowExecutionAdapter();
  }

  async execute(
    workflowId: string,
    input: Record<string, unknown>,
    mode: WorkflowExecutionMode = 'foreground'
  ): Promise<ExecutionResult> {
    output.infoLog(`Executing workflow ${workflowId} in ${mode} mode`);
    const validatedMode = this.validateModeCombination(mode);
    switch (validatedMode) {
      case 'blocking':
        return this.executeBlocking(workflowId, input);
      case 'foreground':
        return this.executeForeground(workflowId, input);
      case 'background':
        return this.executeBackground(workflowId, input);
      default:
        throw new CLIError(`Unsupported execution mode: ${mode}`, ErrorCode.VALIDATION);
    }
  }

  private validateModeCombination(requestedMode: WorkflowExecutionMode): WorkflowExecutionMode {
    const appMode = getMode();
    if (appMode.isInteractive) return requestedMode;
    if (appMode.mode === 'test') return requestedMode;
    if (appMode.isHeadless) {
      if (requestedMode === 'foreground') {
        output.warnLog(
          `Headless mode does not support '${requestedMode}' execution (requires TTY). ` +
          "Falling back to 'blocking' mode for clean output."
        );
        return 'blocking';
      }
      return requestedMode;
    }
    return requestedMode;
  }

  private async executeBlocking(
    workflowId: string,
    input: Record<string, unknown>
  ): Promise<ExecutionResult> {
    output.debugLog('Starting blocking execution');
    const execution = await this.adapter.executeWorkflow(workflowId, input);
    const executionId = 'executionId' in execution ? execution.executionId : (execution as any).id;
    output.infoLog(`Blocking execution completed: ${executionId || 'unknown'}`);
    return {
      mode: 'blocking',
      executionId: executionId || '',
      workflowId,
      status: execution.status || 'completed',
      startTime: new Date(execution.createdAt || Date.now()),
      detached: false,
      result: execution as WorkflowExecutionResult,
    };
  }

  private async executeForeground(
    workflowId: string,
    input: Record<string, unknown>
  ): Promise<ExecutionResult> {
    output.debugLog('Starting foreground execution (subprocess)');
    const childProcess = this.forkChildProcess(workflowId, input, 'foreground');
    const executionId = await this.waitForChildReady(childProcess);
    const terminal = this.terminalManager.createTerminal({ background: false });
    output.infoLog(`Foreground execution started in terminal ${terminal.id} (PID: ${childProcess.pid})`);
    this.displayExecutionInfo(terminal, { workflowId, executionId, mode: 'foreground' });

    const completion = new Promise<void>((resolve) => {
      childProcess.on('message', (msg: any) => {
        if (msg.type === 'event') {
          const event = msg.event;
          if (terminal.pty && 'write' in terminal.pty) {
            let line = '';
            if (event.eventType === 'NODE_STARTED') line = `[${new Date().toISOString()}] \u2192 Node started: ${event.nodeId} (${event.nodeType})\n`;
            else if (event.eventType === 'NODE_COMPLETED') line = `[${new Date().toISOString()}] \u2713 Node completed: ${event.nodeId}\n`;
            else if (event.eventType === 'WORKFLOW_EXECUTION_COMPLETED') line = `[${new Date().toISOString()}] Workflow execution completed\n`;
            else if (event.eventType === 'WORKFLOW_EXECUTION_FAILED') line = `[${new Date().toISOString()}] Workflow execution failed\n`;
            if (line) terminal.pty.write(line);
          }
        } else if (msg.type === 'result' || (msg.type === 'status' && (msg.status === 'completed' || msg.status === 'failed'))) {
          resolve();
        } else if (msg.type === 'error') {
          output.errorLog(`Child process error: ${msg.error?.message || 'Unknown error'}`);
          resolve();
        }
      });
      childProcess.on('exit', () => resolve());
      childProcess.on('error', (err) => { output.errorLog(`Child process error: ${err.message}`); resolve(); });
    });

    return { mode: 'foreground', executionId, workflowId, status: 'running', startTime: new Date(), pid: childProcess.pid, detached: true, completion };
  }

  private async executeBackground(
    workflowId: string,
    input: Record<string, unknown>
  ): Promise<ExecutionResult> {
    output.debugLog('Starting background execution (subprocess)');
    const logFile = `logs/workflow-${workflowId}-${Date.now()}.log`;
    const childProcess = this.forkChildProcess(workflowId, input, 'background', logFile);
    const executionId = await this.waitForChildReady(childProcess);
    output.infoLog(`Background execution started, log file: ${logFile} (PID: ${childProcess.pid})`);

    try {
      const dir = dirname(logFile);
      const { existsSync, mkdirSync, appendFileSync } = await import("fs");
      if (!existsSync(dir)) mkdirSync(dir, { recursive: true });
      appendFileSync(logFile, [
        `[${new Date().toISOString()}] Workflow Execution Started (Background)`,
        `  Workflow ID: ${workflowId}`,
        `  Execution ID: ${executionId}`,
        `  Mode: background`,
        `  Start Time: ${new Date().toISOString()}`,
        '',
      ].join('\n') + '\n', 'utf-8');
    } catch { /* ignore log file errors */ }

    const completion = new Promise<void>((resolve) => {
      childProcess.on('message', (msg: any) => {
        if (msg.type === 'result' || (msg.type === 'status' && (msg.status === 'completed' || msg.status === 'failed'))) resolve();
        else if (msg.type === 'error') { output.errorLog(`Child process error: ${msg.error?.message || 'Unknown error'}`); resolve(); }
      });
      childProcess.on('exit', () => resolve());
      childProcess.on('error', (err) => { output.errorLog(`Child process error: ${err.message}`); resolve(); });
    });

    return { mode: 'background', executionId, workflowId, status: 'running', startTime: new Date(), pid: childProcess.pid, logFile, detached: true, completion };
  }

  private displayExecutionInfo(terminal: TerminalSession, info: { workflowId: string; executionId: string; mode: string }): void {
    const message = [
      '\u2554\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2557',
      '\u2551     Workflow Execution Started           \u2551',
      '\u2560\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2563',
      `\u2551 Workflow: ${info.workflowId.padEnd(30)}\u2551`,
      `\u2551 Execution: ${info.executionId.padEnd(28)}\u2551`,
      `\u2551 Mode: ${info.mode.padEnd(33)}\u2551`,
      '\u255a\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u255d',
      '',
      'This terminal displays real-time execution progress.',
      'The workflow is running via SDK in the background.',
      '',
    ].join('\n');
    if (terminal.pty && 'write' in terminal.pty) terminal.pty.write(message);
  }

  async followExecution(executionId: string): Promise<void> {
    output.infoLog(`Following execution: ${executionId}`);
    const factory = this.sdk.getFactory();
    if (!factory) { output.warnLog('SDK factory not available, cannot follow execution'); return; }
    const dependencies = factory.getDependencies();
    if (!dependencies) { output.warnLog('SDK dependencies not available, cannot follow execution'); return; }

    return new Promise<void>((resolve) => {
      const nodeStartedUnsubscribe = createExecutionScopedSubscription(executionId, 'NODE_STARTED', (event: BaseEvent) => {
        output.infoLog(`[${new Date().toISOString()}] \u2192 Node started: ${(event as any).nodeId} (${(event as any).nodeType})`);
      }, dependencies).subscribe();

      const nodeCompletedUnsubscribe = createExecutionScopedSubscription(executionId, 'NODE_COMPLETED', (event: BaseEvent) => {
        output.infoLog(`[${new Date().toISOString()}] \u2713 Node completed: ${(event as NodeCompletedEvent).nodeId}`);
      }, dependencies).subscribe();

      createExecutionScopedSubscription(executionId, 'WORKFLOW_EXECUTION_COMPLETED', () => {
        nodeStartedUnsubscribe();
        nodeCompletedUnsubscribe();
        resolve();
      }, dependencies).subscribe();

      createExecutionScopedSubscription(executionId, 'WORKFLOW_EXECUTION_FAILED', (event: BaseEvent) => {
        nodeStartedUnsubscribe();
        nodeCompletedUnsubscribe();
        resolve();
      }, dependencies).subscribe();
    });
  }

  async monitorExecution(executionId: string): Promise<{ executionId: string; status: string; progress?: number; lastUpdate: Date }> {
    try {
      const execution = await this.adapter.getWorkflowExecution(executionId);
      return { executionId, status: execution.status || 'unknown', lastUpdate: new Date() };
    } catch (error) {
      const errorMessage = error instanceof Error ? error.message : String(error);
      output.errorLog(`Failed to monitor execution ${executionId}: ${errorMessage}`);
      throw new CLIError(`Failed to monitor execution: ${errorMessage}`, ErrorCode.API, 4);
    }
  }

  async stopExecution(executionId: string): Promise<void> {
    output.infoLog(`Stopping execution: ${executionId}`);
    try {
      await this.adapter.stopWorkflowExecution(executionId);
      output.infoLog(`Execution stopped: ${executionId}`);
    } catch (error) {
      const errorMessage = error instanceof Error ? error.message : String(error);
      output.errorLog(`Failed to stop execution ${executionId}: ${errorMessage}`);
      throw new CLIError(`Failed to stop workflow execution: ${errorMessage}`, ErrorCode.API, 4);
    }
  }

  private forkChildProcess(workflowId: string, input: Record<string, unknown>, mode: 'foreground' | 'background', logFile?: string) {
    const __filename = fileURLToPath(import.meta.url);
    const __dirname = dirname(__filename);
    const childExecutorPath = resolve(__dirname, '../../executors/child-executor.js');
    const args = [workflowId, JSON.stringify(input), mode];
    if (logFile) args.push('', logFile);

    const childProcess = fork(childExecutorPath, args, {
      env: { ...process.env, CHILD_DEBUG: process.env["CLI_DEBUG"] || "", CHILD_LOG_FILE: logFile || "" },
      stdio: ['pipe', 'pipe', 'pipe', 'ipc'],
      detached: true,
    });
    childProcess.unref();
    return childProcess;
  }

  private async waitForChildReady(childProcess: ReturnType<typeof fork>): Promise<string> {
    return new Promise<string>((resolve, reject) => {
      const timeout = setTimeout(() => reject(new CLIError('Child process did not start in time', ErrorCode.TIMEOUT)), 30000);
      childProcess.on('message', (msg: any) => {
        if (msg.type === 'status' && msg.status === 'running') { clearTimeout(timeout); resolve(msg.executionId || 'unknown'); }
        else if (msg.type === 'error') { clearTimeout(timeout); reject(new CLIError(`Child process error: ${msg.error?.message || 'Unknown error'}`, ErrorCode.API)); }
      });
      childProcess.on('error', (err) => { clearTimeout(timeout); reject(err); });
      childProcess.on('exit', (code) => { clearTimeout(timeout); reject(new CLIError(`Child process exited prematurely with code ${code}`, ErrorCode.API)); });
    });
  }

  async cleanup(): Promise<void> {
    output.infoLog('Cleaning up ExecutionService resources...');
    await this.terminalManager.cleanupAll();
    output.infoLog('ExecutionService cleanup completed');
  }
}
