+		setNodeActive(nodeUi.id, 'other');
+	} else {
+		toast.showToast({
+			title: i18n.baseText('nodeView.showMessage.ndvUrl.missingNodes.title'),
+			message: i18n.baseText('nodeView.showMessage.ndvUrl.missingNodes.content'),
+			type: 'warning',
+		});
+		void router.replace({
+			name: route.name,
+			params: { workflowId: workflowId.value },
+			query: route.query,
+		});
+	}
+}
+
+watch([() => route.name, () => route.params.workflowId], () => {
+	// Handle route-specific actions (query actions, debug mode event binding, node issues)
+	initializeRoute();
