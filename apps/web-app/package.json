{
	"name": "@wf-agent/web-app-frontend",
	"version": "1.0.0",
	"description": "Modular Agent Framework Web Application Frontend",
	"type": "module",
	"main": "dist/index.js",
	"scripts": {
		"dev": "node scripts/merge-fragments.mjs && vite dev",
		"dev:preview": "node scripts/merge-fragments.mjs && vite dev --mode preview",
		"build": "node scripts/merge-fragments.mjs && vite build",
		"build:preview": "node scripts/merge-fragments.mjs && vite build --mode preview",
		"preview": "vite preview",
		"start": "node dist/index.js",
		"clean": "rimraf dist",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:preview": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.preview.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"typecheck": "svelte-kit sync && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"lint:i18n": "node scripts/merge-fragments.mjs && node scripts/check-i18n.mjs",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"keywords": [
		"web",
		"frontend",
		"agent",
		"modular-agent"
	],
	"author": "Modular Agent Framework Team",
	"license": "MIT",
	"engines": {
		"node": ">=22.0.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^2.25.4",
		"@inlang/plugin-message-format": "^4.4.4",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/typography": "^0.5.4",
		"@tailwindcss/vite": "^4.1.18",
		"@types/node": "^26.1.1",
		"eslint": "^10.11.0",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"rimraf": "^6.1.3",
		"rollup-plugin-visualizer": "^7.1.1",
		"svelte": "^5.56.4",
		"svelte-check": "^4.7.2",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.70.1",
		"vite": "^8.1.4",
		"vitest": "^5.0.1"
	},
	"dependencies": {
		"@tanstack/hotkeys": "^0.11.0",
		"@tanstack/svelte-hotkeys": "^0.13.0",
		"cytoscape": "^3.34.3",
		"markstream-svelte": "2.0.13",
		"openapi-fetch": "^0.17.0",
		"tailwindcss": "^4.1.18"
	},
	"imports": {
		"#lib/*": "./src/lib/*",
		"#paraglide/*": "./src/lib/paraglide/*"
	}
}
