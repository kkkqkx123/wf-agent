+
+				<WorkflowExecutionAnnotationPanel
+					v-if="isAnnotationEnabled && activeExecution"
+					:execution="activeExecution"
+				/>
+
+				<N8nIconButton
+					variant="outline"
+					:title="locale.baseText('executionDetails.deleteExecution')"
+					:disabled="!executionPermissions.delete"
+					icon="trash-2"
